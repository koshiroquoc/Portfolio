---
// Project card: visual slot, title + one-liner, three mono metrics, tag
// pills. Whole card links to the detail page; hover lifts it, turns the
// border accent and fades in the orange point dot (180ms).
interface Metric {
  value: string;
  label: string;
}
interface Props {
  href: string;
  title: string;
  description: string;
  metrics: Metric[];
  tags: string[];
}
const { href, title, description, metrics, tags } = Astro.props;
---

<article class="card relative rounded-xl border border-grid bg-paper p-6 md:p-8">
  <span
    class="card-dot absolute top-4 right-4 h-2 w-2 rounded-full bg-point"
    aria-hidden="true"></span>
  <!-- Visual slot: the project's architecture figure. TODO: swap for a
       product screenshot if one reads better at this size. -->
  <div
    class="card-visual mb-6 flex h-[180px] items-center justify-center overflow-hidden rounded-lg border border-grid bg-paper"
    aria-hidden="true"
  >
    <slot name="visual" />
  </div>
  <h3 class="font-display text-[22px] font-semibold tracking-[-0.01em]">
    <a href={href} class="after:absolute after:inset-0 after:content-['']">{title}</a>
  </h3>
  <p class="mt-3 max-w-[44ch] text-base text-muted">{description}</p>
  <div class="my-6 grid grid-cols-3 gap-4">
    {
      metrics.map((m) => (
        <div>
          <div class="font-mono text-[26px] leading-none font-medium text-ink sm:text-[30px]">
            {m.value}
          </div>
          <div class="mt-2 font-mono text-[11px] tracking-[0.06em] uppercase text-muted">
            {m.label}
          </div>
        </div>
      ))
    }
  </div>
  <div class="flex flex-wrap gap-2">
    {
      tags.map((tag) => (
        <span class="rounded-full border border-grid px-3 py-1 font-mono text-xs tracking-[0.04em] text-ink">
          {tag}
        </span>
      ))
    }
  </div>
</article>
