---
// Line-art figure for the bike-lane causal study: how a corridor inventory
// becomes a matched station-month panel, and which gate each stage must clear.
// Site palette only.
interface Props {
  title?: string;
}
const { title = 'Bike-lane causal study — design and gates' } = Astro.props;
---

<svg
  viewBox="0 0 840 440"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={title}
  class="diagram-svg"
  style="font-family: 'JetBrains Mono', monospace"
>
  <defs>
    <marker
      id="cz-arrow"
      viewBox="0 0 8 8"
      refX="7"
      refY="4"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M0 0L8 4L0 8z" fill="#131313"></path>
    </marker>
    <marker
      id="cz-arrow-accent"
      viewBox="0 0 8 8"
      refX="7"
      refY="4"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M0 0L8 4L0 8z" fill="#1F77B4"></path>
    </marker>
  </defs>

  <!-- inputs -->
  <text x="24" y="40" font-size="11" letter-spacing="1" fill="#6E6E68">INPUTS</text>

  <rect x="24" y="56" width="140" height="44" rx="8" fill="none" stroke="#131313"></rect>
  <text x="94" y="74" text-anchor="middle" font-size="12" fill="#131313">CDOT bikeways</text>
  <text x="94" y="89" text-anchor="middle" font-size="10" fill="#6E6E68">2024–2025 candidates</text>

  <rect x="24" y="114" width="140" height="44" rx="8" fill="none" stroke="#131313"></rect>
  <text x="94" y="132" text-anchor="middle" font-size="12" fill="#131313">station panel</text>
  <text x="94" y="147" text-anchor="middle" font-size="10" fill="#6E6E68">from Project A</text>

  <!-- treatment audit -->
  <rect x="212" y="76" width="152" height="62" rx="8" fill="none" stroke="#131313"></rect>
  <text x="288" y="100" text-anchor="middle" font-size="12" fill="#131313">treatment audit</text>
  <text x="288" y="115" text-anchor="middle" font-size="10" fill="#6E6E68">first verified month</text>
  <text x="288" y="128" text-anchor="middle" font-size="10" fill="#6E6E68">completion month dropped</text>

  <!-- spatial assignment -->
  <rect x="212" y="176" width="152" height="62" rx="8" fill="none" stroke="#131313"></rect>
  <text x="288" y="200" text-anchor="middle" font-size="12" fill="#131313">300 m buffer</text>
  <text x="288" y="215" text-anchor="middle" font-size="10" fill="#6E6E68">40 treated stations</text>
  <text x="288" y="228" text-anchor="middle" font-size="10" fill="#6E6E68">12 corridors</text>

  <!-- matching -->
  <rect x="412" y="126" width="152" height="62" rx="8" fill="none" stroke="#1F77B4"></rect>
  <text x="488" y="150" text-anchor="middle" font-size="12" fill="#1F77B4">matched controls</text>
  <text x="488" y="165" text-anchor="middle" font-size="10" fill="#6E6E68">3 per treated, in cohort</text>
  <text x="488" y="178" text-anchor="middle" font-size="10" fill="#6E6E68">pre-period only</text>

  <!-- estimation -->
  <rect x="612" y="126" width="152" height="62" rx="8" fill="none" stroke="#1F77B4"></rect>
  <text x="688" y="150" text-anchor="middle" font-size="12" fill="#1F77B4">group-time ATT</text>
  <text x="688" y="165" text-anchor="middle" font-size="10" fill="#6E6E68">staggered adoption</text>
  <text x="688" y="178" text-anchor="middle" font-size="10" fill="#6E6E68">2-way clustered, 11 df</text>

  <!-- flow -->
  <path d="M164 78 H204" stroke="#131313" fill="none" marker-end="url(#cz-arrow)"></path>
  <path d="M164 136 H204" stroke="#131313" fill="none" marker-end="url(#cz-arrow)"></path>
  <path d="M364 107 C388 107, 390 140, 404 148" stroke="#1F77B4" fill="none" marker-end="url(#cz-arrow-accent)"
  ></path>
  <path d="M364 207 C388 207, 390 174, 404 166" stroke="#1F77B4" fill="none" marker-end="url(#cz-arrow-accent)"
  ></path>
  <path d="M564 157 H604" stroke="#1F77B4" fill="none" marker-end="url(#cz-arrow-accent)"></path>

  <!-- gate lane -->
  <rect
    x="24"
    y="292"
    width="740"
    height="120"
    rx="12"
    fill="none"
    stroke="#E7E7E2"
    stroke-dasharray="4 4"></rect>
  <text x="40" y="316" font-size="11" letter-spacing="1" fill="#6E6E68">
    GATES — LOCKED BEFORE ANY EFFECT WAS READ
  </text>

  <rect x="44" y="332" width="150" height="58" rx="8" fill="none" stroke="#131313"></rect>
  <text x="119" y="354" text-anchor="middle" font-size="12" fill="#131313">P3 identification</text>
  <text x="119" y="369" text-anchor="middle" font-size="10" fill="#6E6E68">pre-trend leads</text>
  <text x="119" y="382" text-anchor="middle" font-size="10" fill="#6E6E68">pass with limitations</text>

  <rect x="222" y="332" width="150" height="58" rx="8" fill="none" stroke="#131313"></rect>
  <text x="297" y="354" text-anchor="middle" font-size="12" fill="#131313">P4 estimation</text>
  <text x="297" y="369" text-anchor="middle" font-size="10" fill="#6E6E68">estimator registry</text>
  <text x="297" y="382" text-anchor="middle" font-size="10" fill="#6E6E68">pass</text>

  <rect x="400" y="332" width="150" height="58" rx="8" fill="none" stroke="#131313"></rect>
  <text x="475" y="354" text-anchor="middle" font-size="12" fill="#131313">P5 falsification</text>
  <text x="475" y="369" text-anchor="middle" font-size="10" fill="#6E6E68">16 specs · 50 placebos</text>
  <text x="475" y="382" text-anchor="middle" font-size="10" fill="#6E6E68">pass with limitations</text>

  <rect x="578" y="332" width="164" height="58" rx="8" fill="none" stroke="#1F77B4"></rect>
  <text x="660" y="354" text-anchor="middle" font-size="12" fill="#1F77B4">claims contract</text>
  <text x="660" y="369" text-anchor="middle" font-size="10" fill="#6E6E68">allowed final claim</text>
  <text x="660" y="382" text-anchor="middle" font-size="10" fill="#6E6E68">machine-checked</text>

  <path d="M194 361 H214" stroke="#131313" fill="none" marker-end="url(#cz-arrow)"></path>
  <path d="M372 361 H392" stroke="#131313" fill="none" marker-end="url(#cz-arrow)"></path>
  <path d="M550 361 H570" stroke="#1F77B4" fill="none" marker-end="url(#cz-arrow-accent)"></path>

  <path d="M688 188 V284" stroke="#E7E7E2" stroke-dasharray="4 4" fill="none" marker-end="url(#cz-arrow)"
  ></path>
  <text x="698" y="240" font-size="10" fill="#6E6E68">estimates</text>
</svg>
