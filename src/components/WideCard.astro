---
// Full-width horizontal project card — visual left, content right. Used for the
// headline project in Fig. 01 so its three metrics and longer one-liner get
// room the 2-up cards can't give. Same hover behaviour as ProjectCard.
interface Metric {
  value: string;
  label: string;
}
interface Props {
  href: string;
  title: string;
  description: string;
  metrics: Metric[];
  tags: string[];
}
const { href, title, description, metrics, tags } = Astro.props;
---

<article
  class="card relative grid grid-cols-1 gap-6 rounded-xl border border-grid bg-paper p-6 md:grid-cols-[40%_1fr] md:gap-8 md:p-8"
>
  <span
    class="card-dot absolute top-4 right-4 h-2 w-2 rounded-full bg-point"
    aria-hidden="true"></span>
  <div
    class="card-visual flex h-[180px] items-center justify-center border-b border-grid pb-6 md:h-full md:min-h-[200px] md:border-r md:border-b-0 md:pr-8 md:pb-0"
    aria-hidden="true"
  >
    <slot name="visual" />
  </div>
  <div>
    <h3 class="font-display text-[22px] font-semibold tracking-[-0.01em]">
      <a href={href} class="after:absolute after:inset-0 after:content-['']">{title}</a>
    </h3>
    <p class="mt-3 max-w-[68ch] text-base text-muted">{description}</p>
    <div class="my-6 grid grid-cols-2 gap-4 sm:grid-cols-3">
      {
        metrics.map((m) => (
          <div class="first:col-span-2 sm:first:col-span-1">
            <div class="font-mono text-[28px] leading-none font-medium text-ink sm:text-[30px]">
              {m.value}
            </div>
            <div class="mt-2 font-mono text-[11px] tracking-[0.06em] uppercase text-muted">
              {m.label}
            </div>
          </div>
        ))
      }
    </div>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      {
        tags.map((tag) => (
          <span class="border-l border-grid pl-3 font-mono text-[11px] tracking-[0.06em] uppercase text-muted first:border-l-0 first:pl-0">
            {tag}
          </span>
        ))
      }
    </div>
    <span
      class="mt-6 inline-flex font-mono text-[11px] tracking-[0.08em] uppercase text-accent"
      aria-hidden="true">View case study →</span
    >
  </div>
</article>
