---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import FigRule from '../components/FigRule.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WideCard from '../components/WideCard.astro';
import OtherWork from '../components/OtherWork.astro';
import CausalDiagram from '../components/diagrams/CausalDiagram.astro';
import RagDiagram from '../components/diagrams/RagDiagram.astro';
import BikeshareDiagram from '../components/diagrams/BikeshareDiagram.astro';
import headshot from '../assets/headshot.jpeg';

// Table 1 — secondary team projects. Role is stated so nothing here implies
// more ownership than the git history supports.
const otherWork = [
  {
    name: 'UrbanPulse',
    what: 'Spatial hotness ranking for city exploration · CheeseHacks',
    role: 'team of 4 · scoring & ranking',
    when: 'Mar 2026',
    href: 'https://github.com/M1nhbui/banhmi-cheesehacks',
  },
  {
    name: 'GhostMarket',
    what: 'Sentiment/price decoupling stream pipeline · hackathon',
    role: 'team of 3 · price ingestion',
    when: 'Feb 2026',
    href: 'https://github.com/M1nhbui/ghost_market_936',
  },
];

const toolkit = [
  { group: 'Languages', tags: ['Python', 'R', 'SQL'] },
  {
    group: 'Inference & Modeling',
    tags: [
      'DiD / group-time ATT',
      'bootstrap CIs',
      'scikit-learn',
      'LightGBM',
      'time-series forecasting',
    ],
  },
  {
    group: 'Data & Systems',
    tags: [
      'Polars',
      'DuckDB',
      'Prefect',
      'FastAPI',
      'Elasticsearch',
      'Docker',
      'GitHub Actions',
      'MLflow',
    ],
  },
];

---

<Base
  title="Quoc Van Nguyen — Data Science"
  description="Quoc Van Nguyen is a Data Science, Statistics, and Mathematics student at UW–Madison building trustworthy forecasting, causal inference, and retrieval systems."
>
  <Nav />

  <main id="main-content" tabindex="-1">
    <header id="top" class="relative flex items-center" style="height: calc(100svh - 64px)">
    <div class="absolute inset-y-0 left-0 w-px bg-grid" aria-hidden="true"></div>
    <div class="ticks-left absolute inset-y-0 left-0 w-[7px]" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 h-px bg-grid" aria-hidden="true"></div>
    <div class="ticks-bottom absolute inset-x-0 bottom-0 h-[7px]" aria-hidden="true"></div>
    <div class="container-site relative">
      <p class="caption anim mb-6 text-muted" style="--d: 0ms">
        Quoc Van Nguyen — Data Science / Statistics / Math
      </p>
      <h1
        class="anim font-display max-w-[15ch] text-[clamp(40px,6.5vw,96px)] leading-[1.05] font-semibold tracking-[-0.02em]"
        style="--d: 60ms"
      >
        I design experiments and <span class="text-accent">measure</span> what changes product
        decisions.
      </h1>
      <div
        class="anim mt-8 flex max-w-[80ch] flex-wrap items-center gap-x-6 gap-y-1 font-mono text-[13px] tracking-[0.06em] text-muted"
        style="--d: 120ms"
      >
        <p>// <span class="text-ink">Madison, WI</span> · UW–Madison · expected May 2028</p>
        <a
          href="/resume.pdf"
          class="u-link inline-flex min-h-11 items-center text-accent"
          target="_blank"
          rel="noopener noreferrer"
        >
          résumé.pdf ↗
        </a>
      </div>
      <div class="anim mt-12 grid grid-cols-3 gap-4 sm:flex sm:gap-12" style="--d: 180ms">
        <div>
          <div class="font-mono text-[clamp(28px,3.2vw,44px)] leading-none font-medium text-ink">
            3
          </div>
          <div class="mt-2 font-mono text-[11px] tracking-[0.06em] uppercase text-muted">
            Studies with published evals
          </div>
        </div>
        <div>
          <div class="font-mono text-[clamp(28px,3.2vw,44px)] leading-none font-medium text-ink">
            174
          </div>
          <div class="mt-2 font-mono text-[11px] tracking-[0.06em] uppercase text-muted">
            Automated tests behind the claims
          </div>
        </div>
        <div>
          <div class="font-mono text-[clamp(28px,3.2vw,44px)] leading-none font-medium text-ink">
            3.8
          </div>
          <div class="mt-2 font-mono text-[11px] tracking-[0.06em] uppercase text-muted">
            GPA · DS/Stats/Math
          </div>
        </div>
      </div>
    </div>
    </header>

    <section id="projects" class="flex min-h-[75vh] flex-col justify-center py-16 md:py-30">
    <h2 class="sr-only">Projects</h2>
    <FigRule fig="Fig. 01" label="Projects" />
    <div class="container-site">
      <WideCard
        href="/projects/bikelane-causal"
        title="Protected bike lanes & Divvy ridership"
        description="A causal study of whether newly completed protected bike-lane corridors changed monthly Divvy trip starts at nearby stations. The design was locked before any treatment effect was read."
        metrics={[
          { value: '−10.8%', label: 'Primary ATT · 95% CI −24.0 to +2.3' },
          { value: '16', label: 'Pre-locked robustness specs' },
          { value: '12', label: 'Corridors · 40 treated stations' },
        ]}
        tags={['Python', 'Group-time ATT', 'GeoPandas', 'statsmodels']}
      >
        <Fragment slot="visual"><CausalDiagram /></Fragment>
      </WideCard>
      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
        <ProjectCard
          href="/projects/danang-rag"
          title="Da Nang RAG assistant"
          description="A grounded local-guide assistant over provenance-backed OpenStreetMap places, with a benchmark that decides which retrieval strategy ships."
          metrics={[
            { value: '0.957', label: 'MRR@5 · self-query' },
            { value: '97.5%', label: 'Planner exact match' },
            { value: '210', label: 'Benchmark queries' },
          ]}
          tags={['Elasticsearch', 'Hybrid RRF', 'Gemini', 'Docker']}
        >
          <Fragment slot="visual"><RagDiagram /></Fragment>
        </ProjectCard>
        <ProjectCard
          href="/projects/bikeshare-forecast"
          title="Divvy demand forecasting"
          description="A leakage-safe forecasting system for station-hour bike demand 24 hours ahead — and the upstream panel the causal study reads from."
          metrics={[
            { value: '24.6%', label: 'MAE reduction' },
            { value: '200', label: 'Stations' },
            { value: '51', label: 'Tests' },
          ]}
          tags={['LightGBM', 'Polars', 'FastAPI', 'Docker']}
        >
          <Fragment slot="visual"><BikeshareDiagram /></Fragment>
        </ProjectCard>
      </div>
      <OtherWork rows={otherWork} />
    </div>
    </section>

    <section id="experience" class="flex min-h-[75vh] flex-col justify-center py-16 md:py-30">
    <h2 class="sr-only">Experience</h2>
    <FigRule fig="Fig. 02" label="Experience" />
    <div class="container-site">
      <div class="border-y border-grid">
        <article class="grid gap-4 border-b border-grid py-8 md:grid-cols-[220px_1fr_auto] md:gap-8">
          <div>
            <h3 class="font-display text-[24px] leading-tight font-semibold">AI Engineer Intern</h3>
            <p class="mt-2 font-mono text-[13px] tracking-[0.04em] text-accent">DataHouse Asia</p>
          </div>
          <p class="max-w-[58ch] text-muted">
            Contributed to an internal retrieval-augmented HR assistant, focusing on reducing
            hallucination through prompt, retrieval, and source-grounded output evaluation.
          </p>
          <p class="font-mono text-[13px] tracking-[0.04em] text-muted md:text-right">
            May–Aug 2025<br />Da Nang, Vietnam
          </p>
        </article>
        <article class="grid gap-4 py-8 md:grid-cols-[220px_1fr_auto] md:gap-8">
          <div>
            <h3 class="font-display text-[24px] leading-tight font-semibold">Shift Lead</h3>
            <p class="mt-2 font-mono text-[13px] tracking-[0.04em] text-accent">UW–Madison Housing</p>
          </div>
          <p class="max-w-[58ch] text-muted">
            Led about 10 student workers per shift and trained more than 50 new employees on
            operational workflows, safety, and cross-team collaboration.
          </p>
          <p class="font-mono text-[13px] tracking-[0.04em] text-muted md:text-right">
            Oct 2024–Jul 2026<br />Madison, WI
          </p>
        </article>
      </div>
    </div>
    </section>

    <section id="toolkit" class="flex min-h-[75vh] flex-col justify-center py-16 md:py-30">
    <h2 class="sr-only">Toolkit</h2>
    <FigRule fig="Fig. 03" label="Toolkit" />
    <div class="container-site">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
        {
          toolkit.map(({ group, tags }) => (
            <div class="flex flex-col gap-4">
              <span class="font-mono text-[11px] tracking-[0.08em] uppercase text-muted">
                {group}
              </span>
              <div class="flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <span class="rounded-full border border-grid px-3 py-1 font-mono text-xs tracking-[0.04em] text-ink">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
    </section>

    <section id="about" class="flex min-h-[75vh] flex-col justify-center py-16 md:py-30">
    <h2 class="sr-only">About</h2>
    <FigRule fig="Fig. 04" label="About" />
    <div class="container-site">
      <div class="grid grid-cols-1 items-start gap-12 md:grid-cols-[1.4fr_1fr]">
        <div>
          <p class="max-w-[52ch] text-ink">
            Hi, I'm Quoc Van Nguyen — a Data Science, Statistics, and Mathematics student at
            UW–Madison. I care less about how a model scores in isolation than whether its result
            can be trusted when someone makes a product decision.
          </p>
          <p class="mt-4 max-w-[52ch] text-muted">
            My work pairs causal designs for questions where before-and-after comparisons would
            lie with evaluation harnesses for systems whose output is text. That perspective grew
            from building forecasting and retrieval systems, including an AI engineering internship
            focused on reducing hallucination in an internal RAG assistant.
          </p>
        </div>
        <figure class="m-0">
          <div
            class="relative aspect-square overflow-hidden rounded-xl border border-grid bg-accent-strong"
          >
            <Image
              src={headshot}
              alt="Quoc Van Nguyen wearing a navy suit and blue tie"
              widths={[400, 800, 1080]}
              sizes="(min-width: 768px) 420px, 90vw"
              class="h-full w-full object-cover object-center mix-blend-luminosity brightness-105 contrast-[1.08] grayscale"
            />
          </div>
          <figcaption class="mt-3 font-mono text-[13px] tracking-[0.05em] text-muted">
            Quoc Van Nguyen · Madison, WI
          </figcaption>
        </figure>
      </div>
    </div>
    </section>

    {/* Off the clock is deferred until real photos and EXIF exist. See PRODUCT.md. */}
    <section id="contact" class="flex min-h-[75vh] flex-col justify-center py-16 md:py-30">
    <h2 class="sr-only">Contact</h2>
    <FigRule fig="Fig. 05" label="Contact" />
    <div class="container-site">
      <div class="flex flex-col items-start gap-4">
        <a
          href="mailto:qvnguyen3@wisc.edu"
          class="u-link font-mono text-[clamp(18px,3vw,26px)] font-medium text-accent"
          ><span class="text-muted">email </span>qvnguyen3@wisc.edu</a
        >
        <a
          href="https://github.com/koshiroquoc"
          class="u-link font-mono text-[clamp(18px,3vw,26px)] font-medium text-ink"
          ><span class="text-muted">github </span>github.com/koshiroquoc</a
        >
        <a
          href="https://www.linkedin.com/in/quoc-nguyenvan/"
          class="u-link font-mono text-[clamp(18px,3vw,26px)] font-medium text-ink"
          ><span class="text-muted">linkedin </span>linkedin.com/in/quoc-nguyenvan</a
        >
        <a
          href="/resume.pdf"
          class="u-link font-mono text-[clamp(18px,3vw,26px)] font-medium text-ink"
          target="_blank"
          rel="noopener noreferrer"
          ><span class="text-muted">résumé </span>view PDF ↗</a
        >
      </div>
      <p class="mt-16 font-mono text-[11px] tracking-[0.05em] text-muted">
        Fig. 05 — Quoc Van Nguyen · 2026 · built like a figure from a stats paper.
      </p>
    </div>
    </section>
  </main>
</Base>
